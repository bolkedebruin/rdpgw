{
  "Server": {
    "Tls": "auto",
    "Port": 443,
    "SessionStore": "cookie",
    "HostSelection": "roundrobin",
    "DatabaseFile": "rdpgw.db",
    "Authentication": [
      "openid"
    ],
    "AuthSocket": "/tmp/rdpgw-auth.sock",
    "BasicAuthTimeout": 5
  },
  "Security": {
    "VerifyClientIp": true
  },
  "Caps": {
    "TokenAuth": true
  },
  "Orchestrator": {
    "OrchestratorAddress": "",
    "RegistrationPollIntervalSeconds": 60
  }
}
