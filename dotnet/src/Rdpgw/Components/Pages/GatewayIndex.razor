@page "/gateways"
@using Rdpgw.Components.Dialogs
@using Rdpgw.Data
@using Rdpgw.Web
@inject Handler Handler
@inject GatewayStore GatewayStore
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>@Handler.WebConfig.Branding.Title - Gateways</PageTitle>

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Primary">
        <MudText Typo="Typo.h6">@Handler.WebConfig.Branding.Logo</MudText>
        <MudSpacer />
        <MudButton Href="/" StartIcon="@Icons.Material.Filled.Home" Color="Color.Inherit">Home</MudButton>
    </MudAppBar>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="mt-8">
            <div class="d-flex align-center mb-4">
                <MudText Typo="Typo.h4">Gateway Management</MudText>
            </div>

            <MudText Typo="Typo.h6" Class="mb-2">Pending Gateways</MudText>
            <MudTable Items="_pendingGateways" Hover="true" Striped="true" Loading="_loading" Elevation="3" Class="mb-8">
                <HeaderContent>
                    <MudTh>Name</MudTh>
                    <MudTh Style="width: 120px;">Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Name">@context.Name</MudTd>
                    <MudTd DataLabel="Actions">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                   Disabled="_adopting.Contains(context.Id)"
                                   OnClick="@(() => AdoptGatewayAsync(context))">Adopt</MudButton>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText>No gateways are pending registration.</MudText>
                </NoRecordsContent>
            </MudTable>

            <MudText Typo="Typo.h6" Class="mb-2">Registered Gateways</MudText>
            <MudTable Items="_gateways" Hover="true" Striped="true" Loading="_loading" Elevation="3">
                <HeaderContent>
                    <MudTh>Name</MudTh>
                    <MudTh>Address</MudTh>
                    <MudTh>Description</MudTh>
                    <MudTh Style="width: 120px;">Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Name">@context.Name</MudTd>
                    <MudTd DataLabel="Address">@context.Address</MudTd>
                    <MudTd DataLabel="Description">@context.Description</MudTd>
                    <MudTd DataLabel="Actions">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                                       OnClick="@(() => EditGatewayAsync(context))" aria-label="Edit gateway" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                       OnClick="@(() => DeleteGatewayAsync(context))" aria-label="Delete gateway" />
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText>No gateways registered yet. Gateways register themselves and appear above as pending until adopted.</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private List<GatewayEntry> _gateways = [];
    private List<PendingGatewayEntry> _pendingGateways = [];
    private readonly HashSet<int> _adopting = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _gateways = await GatewayStore.GetAllAsync();
        _pendingGateways = await GatewayStore.GetPendingAsync();
        _loading = false;
    }

    private async Task AdoptGatewayAsync(PendingGatewayEntry pending)
    {
        _adopting.Add(pending.Id);
        try
        {
            await GatewayStore.AdoptAsync(pending.Id);
            Snackbar.Add($"Gateway '{pending.Name}' adopted.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to adopt gateway '{pending.Name}': {ex.Message}", Severity.Error);
        }
        finally
        {
            _adopting.Remove(pending.Id);
        }
        await LoadAsync();
    }

    private async Task EditGatewayAsync(GatewayEntry gateway)
    {
        var edit = new GatewayDto { Name = gateway.Name, Address = gateway.Address, Description = gateway.Description, GatewaySigningKey = gateway.GatewaySigningKey };
        var parameters = new DialogParameters<GatewayEditDialog> { { d => d.Gateway, edit } };

        var dialog = await DialogService.ShowAsync<GatewayEditDialog>("Edit Gateway", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: GatewayDto updated })
        {
            try
            {
                await GatewayStore.UpdateAsync(gateway.Id, updated.Name, updated.Address, updated.Description, updated.GatewaySigningKey, updated.IsDefault);
                Snackbar.Add($"Gateway '{updated.Name}' updated.", Severity.Success);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Failed to update gateway: {ex.Message}", Severity.Error);
            }
            await LoadAsync();
        }
    }

    private async Task DeleteGatewayAsync(GatewayEntry gateway)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync("Delete Gateway", $"Delete gateway '{gateway.Name}' ({gateway.Address})? Hosts using it will fall back to the default gateway.", yesText: "Delete", cancelText: "Cancel");
        if (confirmed == true)
        {
            try
            {
                await GatewayStore.DeleteAsync(gateway.Id);
                Snackbar.Add($"Gateway '{gateway.Name}' deleted.", Severity.Success);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Failed to delete gateway: {ex.Message}", Severity.Error);
            }
            await LoadAsync();
        }
    }
}
